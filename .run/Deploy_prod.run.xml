<component name="ProjectRunConfigurationManager">
  <!-- Кнопка деплоя в IDE: дёргает workflow_dispatch через GitHub CLI, браузер не нужен.
       Требует установленного gh (пакет github-cli) и однократного `gh auth login`.
       Для откака поменять tag на sha-<коммит>. -->
  <configuration default="false" name="Deploy prod" type="ShConfigurationType">
