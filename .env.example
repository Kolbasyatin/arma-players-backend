# Конфигурация для ЛОКАЛЬНОГО запуска (go run ./cmd/observer) и тестов.
# Скопировать в .env — он в .gitignore. Читает сам процесс через godotenv.
#
# Порядок и состав разделов ОДИН И ТОТ ЖЕ, что в deploy/.env.example: отличаются только
# значения. Расхождение состава ловится тестом internal/config/config_test.go.

# --- База данных -------------------------------------------------------------------------
# Строка подключения. Без неё observer не стартует.
DATABASE_URL=postgres://armaplayers:armaplayers@localhost:5434/armaplayers?sslmode=disable
# Отдельная база для интеграционных тестов: они её чистят перед каждым тестом.
# Не переменная приложения — читается только из тестов.
DATABASE_URL_TEST=postgres://armaplayers:armaplayers@localhost:5434/armaplayers_test?sslmode=disable

# --- HTTP и REST API (docs/api.md) --------------------------------------------------------
# Служебные /health и /observation-status + REST для бота. Пустой токен = REST выключен.
HTTP_ADDR=:8081
API_TOKEN=

# --- Токен Bohemia ------------------------------------------------------------------------
# Сервис arma-reforger-hz, отдающий BI access token.
TOKEN_URL=http://localhost:5283/token

# --- Кого отслеживать (ADR 0008) ----------------------------------------------------------
# Ручной список ip:port через запятую, без пробелов. Всегда в опросе, может быть пустым.
TRACK_HOST_ADDRESSES=37.48.253.41:2001
# Авто-правило: серверы с пиковым онлайном за окно >= MIN, не больше MAX штук. MIN=0 выключает.
TRACK_AUTO_MIN_PLAYERS=0
TRACK_AUTO_MAX_SERVERS=10
TRACK_AUTO_LOOKBACK=168h

# --- Опрос игроков (AGENTS §14) -----------------------------------------------------------
# За POLL_INTERVAL опрашиваются все серверы, старты равномерно распределены по интервалу
# (N серверов -> один старт каждые INTERVAL/N). CONCURRENCY — предел одновременных опросов.
POLL_INTERVAL=1m
POLL_CONCURRENCY=4

# --- Полный скан лобби (AGENTS §13) -------------------------------------------------------
# Интервал, пауза после неудачи, размер страницы (до 500).
LOBBY_SCAN_INTERVAL=24h
LOBBY_SCAN_RETRY=15m
LOBBY_PAGE_SIZE=500

# --- Присутствие (ADR 0005) ---------------------------------------------------------------
# Сколько успешных опросов подряд без игрока = выход; разрыв данных, после которого сессии
# закрываются как DATA_GAP без события выхода.
PRESENCE_ABSENT_CONFIRMATIONS=2
PRESENCE_MAX_GAP=15m

# --- Сырые ответы Bohemia (AGENTS §12) ----------------------------------------------------
# Всё содержимое ответов разложено по таблицам, поэтому сырьё нужно только для отладки формата
# и по умолчанию НЕ хранится: на проде оно занимало 5,7 ГБ из 11.
#   off  — не хранить (по умолчанию)
#   scan — только ответы полного скана лобби, ~16 МБ на скан
#   all  — плюс ответы минутного опроса: десятки гигабайт, только на время отладки
RAW_STORE=off
RAW_RETENTION=48h
# Как часто чистится просроченное сырьё.
RETENTION_INTERVAL=1h

# --- Данные Steam об избранных игроках (AGENTS §29a) --------------------------------------
# Корень сервиса arma-reforger-hz — он знает ключ Steam Web API (эндпоинт /steam/{steamId64}).
# Пусто — тема выключена целиком, observer работает ровно как раньше.
STEAM_GATEWAY_URL=
# Как часто просыпается обход списка обогащения.
STEAM_REFRESH_INTERVAL=1h
# За какой срок игрок должен появиться на наших серверах, чтобы считаться активным.
STEAM_ACTIVE_WINDOW=168h
# Через сколько данные считаются устаревшими: для активного и для остальных.
STEAM_ACTIVE_STALENESS=24h
STEAM_IDLE_STALENESS=168h
# Сколько игроков за один проход. Пачка размазывается по интервалу: шаг = интервал / пачка.
STEAM_BATCH=50

# --- Свёртки и чистка растущих таблиц (AGENTS §12) ------------------------------------------
# Подробности живут ограниченный срок, свёртки нагрузки — вечно: они на два порядка меньше.
# Замер 23.09.2026: без чистки три таблицы росли на ~240 МБ в сутки, то есть месяц до конца диска.
# Ноль в любом из сроков выключает чистку этой таблицы; свёртки при этом считаются как обычно.
ROLLUP_INTERVAL=1h
# Насколько назад пересчитывается детальная свёртка (должно быть заметно больше интервала:
# так интервал, свёрнутый наполовину из-за рестарта, досчитается на следующем проходе).
ROLLUP_OVERLAP=3h
# Сколько последних суток пересчитывать в суточных свёртках. Минимум 1: текущие сутки не закончились.
ROLLUP_OVERLAP_DAYS=2
# Сколько хранить подробности. Наполненность серверов после чистки остаётся в свёртках.
OBSERVATION_RETENTION=168h
POLL_RUN_RETENTION=168h
# Лента событий — это outbox для бота, он читает её курсором каждые 15 секунд.
# Сама история визитов лежит в player_server_session и чисткой не затрагивается.
EVENT_RETENTION=168h

# --- Логи -----------------------------------------------------------------------------------
# JSON в stdout всегда. LOG_FILE добавляет файл с ротацией; пусто — только stdout.
LOG_FILE=
LOG_MAX_SIZE_MB=50
LOG_MAX_BACKUPS=10
LOG_MAX_AGE_DAYS=30

# --- Протокольные константы lobby API -------------------------------------------------------
# Сняты с клиента и меняются вместе с версией игры. Пусто — рабочие значения из internal/config;
# заполнять только после патча Arma, когда старые перестанут приниматься.
BOHEMIA_BASE_URL=
BOHEMIA_PLATFORM_ID=
BOHEMIA_GAME_CLIENT_TYPE=
BOHEMIA_CLIENT_VERSION=
BOHEMIA_USER_AGENT=
