# PostgreSQL (пока не используется)
DATABASE_URL=postgres://armaplayers:armaplayers@localhost:5434/armaplayers?sslmode=disable

# HTTP: /health, /observation-status + REST API для бота (API_TOKEN пустой = API выключен)
HTTP_ADDR=:8081
API_TOKEN=

# Опрос отслеживаемых серверов: за POLL_INTERVAL опрашиваются все серверы, старты равномерно
# распределены по интервалу (N серверов → один старт каждые INTERVAL/N). CONCURRENCY — предел одновременных.
POLL_INTERVAL=1m
POLL_CONCURRENCY=4

# Какие серверы отслеживать (ADR 0008): ручной список адресов и/или авто-правило по онлайну
TRACK_HOST_ADDRESSES=37.48.253.41:2001
TRACK_AUTO_MIN_PLAYERS=0
TRACK_AUTO_MAX_SERVERS=10
TRACK_AUTO_LOOKBACK=168h

# Присутствие (ADR 0005): сколько подряд отсутствий = выход; разрыв данных, после которого сессии закрываются
PRESENCE_ABSENT_CONFIRMATIONS=2
PRESENCE_MAX_GAP=15m

# Чистка сырых ответов с истёкшим сроком
RETENTION_INTERVAL=1h

# Полный скан лобби: интервал, повтор после ошибки, размер страницы (до 500), срок хранения сырых ответов
LOBBY_SCAN_INTERVAL=24h
LOBBY_SCAN_RETRY=15m
LOBBY_PAGE_SIZE=500
RAW_RETENTION=336h

# Сервис arma-reforger-hz, отдающий BI access token
TOKEN_URL=http://localhost:5283/token

# Протокольные константы Bohemia API — дефолты в коде, переопределять после патча игры
#BOHEMIA_BASE_URL=https://api-ar-game.bistudio.com/game-api/api/v1.0
#BOHEMIA_PLATFORM_ID=ReforgerSteam
#BOHEMIA_GAME_CLIENT_TYPE=PLATFORM_PC
#BOHEMIA_CLIENT_VERSION=1.8.0
#BOHEMIA_USER_AGENT=Arma Reforger/1.8.0.13 (Client; Windows)
DATABASE_URL_TEST=postgres://armaplayers:armaplayers@localhost:5434/armaplayers_test?sslmode=disable

# Локально логи только в stdout; для файла раскомментируй:
#LOG_FILE=logs/observer.log
